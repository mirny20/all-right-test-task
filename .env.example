# Template only, not read at runtime. Copy to .env (gitignored) and fill in the values:
#   cp .env.example .env
# All variables are required; tests fail fast if one is missing.
# Never commit real values here. Passwords live only in your local .env and in GitHub Secrets;
# usernames are not secret and live in GitHub Variables (see README, "CI setup").

# saucedemo.com (UI tests)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=
SAUCE_LOCKED_USERNAME=locked_out_user

# restful-booker (API tests)
BOOKER_USERNAME=
BOOKER_PASSWORD=
